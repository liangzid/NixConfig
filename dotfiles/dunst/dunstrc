# dunst — Tokyo Night 配色（与 waybar/wofi 统一）
[global]
    font = Sarasa UI SC 11
    origin = top-right
    offset = (12, 12)
    corner_radius = 10
    frame_width = 1
    frame_color = "#7aa2f7"
    separator_color = frame
    gap_size = 4
    padding = 8
    horizontal_padding = 12
    text_icon_padding = 8
    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_age_threshold = 60
    ellipsize = middle
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 8

[urgency_critical]
    background = "#f7768e"
    foreground = "#1a1b26"
    timeout = 0
