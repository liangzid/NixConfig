# dunst — Tokyo Night 玻璃卡片风格（与 waybar/wofi 统一，配合 Hyprland blur）
[global]
    font = Sarasa UI SC 11
    origin = top-right
    offset = (14, 44)
    corner_radius = 14
    frame_width = 1
    frame_color = "#7aa2f7"
    separator_color = frame
    gap_size = 8
    padding = 10
    horizontal_padding = 14
    text_icon_padding = 10
    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_age_threshold = 60
    ellipsize = middle
    icon_position = left
    min_icon_size = 40
    max_icon_size = 56
    highlight = "#7dcfff"
    progress_bar_height = 6
    progress_bar_frame_width = 0
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#1a1b26cc"
    foreground = "#a9b1d6"
    frame_color = "#3b4261"
    timeout = 5

[urgency_normal]
    background = "#1a1b26cc"
    foreground = "#c0caf5"
    timeout = 8

[urgency_critical]
    background = "#f7768eb3"
    foreground = "#1a1b26"
    frame_color = "#f7768e"
    timeout = 0
