#     Created: 30 August 2026
# ======================================================================

theme = TokyoNight

term = xterm-256color

# REVIEW: 0.76 保留明显的壁纸透出，同时避免文字区域过度发灰。
background-opacity = 0.76
background-opacity-cells = true

font-family = FiraCode Nerd Font
font-size = 11

# 四周留白与余数均衡能消除字符紧贴窗口边缘的廉价感。
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

# 让 GTK 标题栏和标签区域继承 Tokyo Night 前景/背景色。
window-theme = ghostty

